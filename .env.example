# KSeF
KSEF_ENV=test
KSEF_NIP=1234567890
KSEF_TOKEN=your-ksef-api-token-here
CHECK_INTERVAL_MINUTES=15

# Notifications
NOTIFICATION_CHANNELS=["mail"]

# Mail (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ksef-monitor@example.com
MAIL_TO=["admin@example.com"]

# Storage
STORAGE_PATH=data/invoices.db

# Metrics (Prometheus)
METRICS_ENABLED=true
METRICS_PORT=8000

# Logger
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
