NAME='default' # change for name, according to makefile name=

# KSeF
KSEF_ENV=test # Literal['test','demo','prod'] = prod for actual use.
KSEF_NIP=1234567890
# KSEF_AUTH_METHOD: "token" (KSeF 1.0, działa do 31.12.2026) lub
# "certificate" (KSeF 2.0, jedyna metoda od 01.01.2027).
KSEF_AUTH_METHOD=token
# Wymagane dla method=token:
KSEF_TOKEN=your-ksef-api-token-here
# Wymagane dla method=certificate (para PEM: certyfikat .crt/.pem + klucz .key):
KSEF_CERT_PATH=secrets/ksef-cert.crt
KSEF_KEY_PATH=secrets/ksef-cert.key
KSEF_KEY_PASSWORD=
CHECK_INTERVAL_MINUTES=15

# Notifications
NOTIFICATION_CHANNELS=["mail"]

# Mail (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ksef-monitor@example.com
MAIL_TO=["admin@example.com"]

# Storage
STORAGE_PATH=data/invoices.db

# Metrics (Prometheus)
METRICS_ENABLED=true
METRICS_PORT=8001
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

# Logger
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
